# Zephyr Weather — build-time API keys.
#
# Copy this file to `.env` (gitignored) and fill in the keys you have.
# `.env` is read at bundle time by react-native-dotenv, so rebuild and
# restart Metro with `--reset-cache` after changing it.
#
# A blank key disables that provider entirely: the app falls back to the
# keyless national services and Open-Meteo instead of failing. Never commit
# a real key.

# Netherlands — KNMI Data Platform Open Data key.
# https://developer.dataplatform.knmi.nl/
KNMI_API_KEY=

# France — Météo-France public API key. Create a free account at
# https://portail-api.meteofrance.fr/, subscribe to the API product you need,
# then generate a token under "My API". It is a single value sent in the
# `apikey` header (no OAuth2 client id/secret).
METEOFRANCE_API_KEY=

# Spain — AEMET OpenData API key.
# https://opendata.aemet.es/
AEMET_API_KEY=

# South Korea — KMA (data.go.kr) service key.
# https://data.kma.go.kr/
KMA_API_KEY=

# Taiwan — CWA open-data API key.
# https://opendata.cwa.gov.tw/
CWA_API_KEY=

# Europe — MeteoAlarm (EUMETNET) warnings API token.
# https://api.meteoalarm.org/register
METEOALARM_API_KEY=
