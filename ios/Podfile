require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/expo/scripts/autolinking'

platform :ios, '16.4'
prepare_react_native_project!

# Static frameworks are required for Expo SDK 57+ Swift module interop.
# Without this, Expo pods can't import ExpoModulesCore properly.
use_frameworks! :linkage => :static

target 'ZephyrWeather' do
  config = use_native_modules!
  use_expo_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true,
    :fabric_enabled => false,
    :new_arch_enabled => false
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => true
    )

    # Fix: Expo pod can't find ExpoModulesCore headers when building
    # with static frameworks. Add the public headers path explicitly.
    installer.pods_project.targets.each do |target|
      if target.name == 'Expo'
        target.build_configurations.each do |config|
          existing = config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
          existing = [existing] unless existing.is_a?(Array)
          existing << '"$(PODS_ROOT)/Headers/Public"'
          config.build_settings['HEADER_SEARCH_PATHS'] = existing
        end
      end
    end

    # Fix deployment target for pods that are below the minimum supported version
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Ensure all pods support Mac Catalyst
        config.build_settings['SUPPORTS_MACCATALYST'] = 'YES'
        config.build_settings['DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER'] = 'YES'

        # Bump deployment target to the minimum supported by Expo 57
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
      end
    end

    # Fix: fmt 11.x consteval is incompatible with Xcode 16+ clang.
    # fmt uses #define (not #ifndef) so -DFMT_USE_CONSTEVAL=0 gets overridden.
    # Patch the header to use #ifndef to respect user overrides.
    base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(base_h)
      File.chmod(0644, base_h)  # CocoaPods may install files read-only
      contents = File.read(base_h)
      # Replace the consteval detection block (lines 113-132) with an #ifndef-guarded version
      old_block = <<~BLOCK
        // Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.
        #if !defined(__cpp_lib_is_constant_evaluated)
        #  define FMT_USE_CONSTEVAL 0
        #elif FMT_CPLUSPLUS < 201709L
        #  define FMT_USE_CONSTEVAL 0
        #elif FMT_GLIBCXX_RELEASE && FMT_GLIBCXX_RELEASE < 10
        #  define FMT_USE_CONSTEVAL 0
        #elif FMT_LIBCPP_VERSION && FMT_LIBCPP_VERSION < 10000
        #  define FMT_USE_CONSTEVAL 0
        #elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L
        #  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14.
        #elif FMT_MSC_VERSION && FMT_MSC_VERSION < 1929
        #  define FMT_USE_CONSTEVAL 0  // consteval is broken in MSVC VS2019 < 16.10.
        #elif defined(__cpp_consteval)
        #  define FMT_USE_CONSTEVAL 1
        #elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101
        #  define FMT_USE_CONSTEVAL 1
        #else
        #  define FMT_USE_CONSTEVAL 0
        #endif
      BLOCK
      new_block = <<~BLOCK
        // Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.
        #ifndef FMT_USE_CONSTEVAL
        #  if !defined(__cpp_lib_is_constant_evaluated)
        #    define FMT_USE_CONSTEVAL 0
        #  elif FMT_CPLUSPLUS < 201709L
        #    define FMT_USE_CONSTEVAL 0
        #  elif FMT_GLIBCXX_RELEASE && FMT_GLIBCXX_RELEASE < 10
        #    define FMT_USE_CONSTEVAL 0
        #  elif FMT_LIBCPP_VERSION && FMT_LIBCPP_VERSION < 10000
        #    define FMT_USE_CONSTEVAL 0
        #  elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L
        #    define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14.
        #  elif FMT_MSC_VERSION && FMT_MSC_VERSION < 1929
        #    define FMT_USE_CONSTEVAL 0  // consteval is broken in MSVC VS2019 < 16.10.
        #  elif defined(__cpp_consteval)
        #    define FMT_USE_CONSTEVAL 1
        #  elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101
        #    define FMT_USE_CONSTEVAL 1
        #  else
        #    define FMT_USE_CONSTEVAL 0
        #  endif
        #endif
      BLOCK
      if contents.include?(old_block.strip)
        contents.sub!(old_block.strip, new_block.strip)
        File.write(base_h, contents)
        Pod::UI.puts "[ZephyrWeather] Patched fmt base.h to support -DFMT_USE_CONSTEVAL=0".green
      end
    end

    # Also add the define to fmt's xcconfig so the patched header guard works
    fmt_xcconfigs = [
      "#{installer.sandbox.root}/Target Support Files/fmt/fmt.debug.xcconfig",
      "#{installer.sandbox.root}/Target Support Files/fmt/fmt.release.xcconfig"
    ]
    fmt_xcconfigs.each do |xcconfig_path|
      if File.exist?(xcconfig_path)
        File.chmod(0644, xcconfig_path)
        unless File.read(xcconfig_path).include?('-DFMT_USE_CONSTEVAL=0')
          File.open(xcconfig_path, 'a') { |f| f.puts "\nOTHER_CPLUSPLUSFLAGS = $(inherited) -DFMT_USE_CONSTEVAL=0" }
        end
      end
    end
  end
end
