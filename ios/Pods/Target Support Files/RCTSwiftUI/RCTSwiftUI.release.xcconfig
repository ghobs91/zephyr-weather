CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
CONFIGURATION_BUILD_DIR = ${PODS_CONFIGURATION_BUILD_DIR}/RCTSwiftUI
DEFINES_MODULE = YES
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
OTHER_CFLAGS = $(inherited) -ivfsoverlay "/Users/andrewg/Projects/zephyr-weather/ios/Pods/React-Core-prebuilt/React-VFS.yaml"  -isystem "${PODS_ROOT}/React-Core-prebuilt/React.xcframework/Headers" -fmodule-map-file="${PODS_ROOT}/Target\ Support\ Files/React-Core-prebuilt/React-use-frameworks.modulemap"
OTHER_CPLUSPLUSFLAGS = $(inherited) -ivfsoverlay "/Users/andrewg/Projects/zephyr-weather/ios/Pods/React-Core-prebuilt/React-VFS.yaml"
OTHER_SWIFT_FLAGS = $(inherited) -Xcc -ivfsoverlay -Xcc "/Users/andrewg/Projects/zephyr-weather/ios/Pods/React-Core-prebuilt/React-VFS.yaml" -Xcc -Wno-incomplete-umbrella  -Xcc -isystem -Xcc "${PODS_ROOT}/React-Core-prebuilt/React.xcframework/Headers" -Xcc -fmodule-map-file="${PODS_ROOT}/Target\ Support\ Files/React-Core-prebuilt/React-use-frameworks.modulemap"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/../../node_modules/react-native/ReactApple/RCTSwiftUI
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
SWIFT_VERSION = 5.0
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
SWIFT_EMIT_MODULE_INTERFACE = NO
