CLANG_CXX_LANGUAGE_STANDARD = c++20
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
CONFIGURATION_BUILD_DIR = ${PODS_CONFIGURATION_BUILD_DIR}/React-jsitracing
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/React-Core-prebuilt" "${PODS_ROOT}/ReactNativeDependencies/framework/packages/react-native" "${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal" "${PODS_XCFRAMEWORKS_BUILD_DIR}/React-Core-prebuilt" "${PODS_XCFRAMEWORKS_BUILD_DIR}/ReactNativeDependencies" "${PODS_XCFRAMEWORKS_BUILD_DIR}/hermes-engine/Pre-built"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
GCC_WARN_PEDANTIC = YES
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/React-Core-prebuilt" "${PODS_ROOT}/Headers/Public/React-jsi" "${PODS_ROOT}/Headers/Public/ReactNativeDependencies" "${PODS_ROOT}/Headers/Public/hermes-engine" "${PODS_TARGET_SRCROOT}/../.."
OTHER_CFLAGS = $(inherited) -ivfsoverlay "/Users/andrewg/Projects/zephyr-weather/ios/Pods/React-Core-prebuilt/React-VFS.yaml" -isystem "${PODS_ROOT}/Headers/Public" -isystem "${PODS_ROOT}/Headers/Public/React-Core-prebuilt" -isystem "${PODS_ROOT}/Headers/Public/React-jsi" -isystem "${PODS_ROOT}/Headers/Public/ReactNativeDependencies" -isystem "${PODS_ROOT}/Headers/Public/hermes-engine" -isystem "${PODS_TARGET_SRCROOT}/../.." -isystem "${PODS_ROOT}/React-Core-prebuilt/React-Core-prebuilt.framework/Headers" -isystem "${PODS_ROOT}/ReactNativeDependencies/framework/packages/react-native/react-native.framework/Headers" -isystem "${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal/universal.framework/Headers" -isystem "${PODS_XCFRAMEWORKS_BUILD_DIR}/React-Core-prebuilt/React-Core-prebuilt.framework/Headers" -isystem "${PODS_XCFRAMEWORKS_BUILD_DIR}/ReactNativeDependencies/ReactNativeDependencies.framework/Headers" -isystem "${PODS_XCFRAMEWORKS_BUILD_DIR}/hermes-engine/Pre-built/Pre-built.framework/Headers" -isystem "${PODS_ROOT}/React-Core-prebuilt/React.xcframework/Headers" -fmodule-map-file="${PODS_ROOT}/Target\ Support\ Files/React-Core-prebuilt/React-use-frameworks.modulemap"
OTHER_CPLUSPLUSFLAGS = $(inherited) -ivfsoverlay "/Users/andrewg/Projects/zephyr-weather/ios/Pods/React-Core-prebuilt/React-VFS.yaml"
OTHER_SWIFT_FLAGS = $(inherited) -Xcc -ivfsoverlay -Xcc "/Users/andrewg/Projects/zephyr-weather/ios/Pods/React-Core-prebuilt/React-VFS.yaml" -Xcc -Wno-incomplete-umbrella -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-Core-prebuilt" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-jsi" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/ReactNativeDependencies" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/hermes-engine" -Xcc -isystem -Xcc "${PODS_TARGET_SRCROOT}/../.." -Xcc -isystem -Xcc "${PODS_ROOT}/React-Core-prebuilt/React-Core-prebuilt.framework/Headers" -Xcc -isystem -Xcc "${PODS_ROOT}/ReactNativeDependencies/framework/packages/react-native/react-native.framework/Headers" -Xcc -isystem -Xcc "${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal/universal.framework/Headers" -Xcc -isystem -Xcc "${PODS_XCFRAMEWORKS_BUILD_DIR}/React-Core-prebuilt/React-Core-prebuilt.framework/Headers" -Xcc -isystem -Xcc "${PODS_XCFRAMEWORKS_BUILD_DIR}/ReactNativeDependencies/ReactNativeDependencies.framework/Headers" -Xcc -isystem -Xcc "${PODS_XCFRAMEWORKS_BUILD_DIR}/hermes-engine/Pre-built/Pre-built.framework/Headers" -Xcc -isystem -Xcc "${PODS_ROOT}/React-Core-prebuilt/React.xcframework/Headers" -Xcc -fmodule-map-file="${PODS_ROOT}/Target\ Support\ Files/React-Core-prebuilt/React-use-frameworks.modulemap"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/../../node_modules/react-native/ReactCommon/hermes/executor
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
USE_HEADERMAP = YES
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
SWIFT_EMIT_MODULE_INTERFACE = NO
