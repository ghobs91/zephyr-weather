CLANG_CXX_LANGUAGE_STANDARD = c++20
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
CONFIGURATION_BUILD_DIR = ${PODS_CONFIGURATION_BUILD_DIR}/React-networking
DEFINES_MODULE = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/React-Core-prebuilt" "${PODS_ROOT}/ReactNativeDependencies/framework/packages/react-native" "${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal" "${PODS_XCFRAMEWORKS_BUILD_DIR}/React-Core-prebuilt" "${PODS_XCFRAMEWORKS_BUILD_DIR}/ReactNativeDependencies" "${PODS_XCFRAMEWORKS_BUILD_DIR}/hermes-engine/Pre-built"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Private" "${PODS_ROOT}/Headers/Private/React-networking" "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/React-Core-prebuilt" "${PODS_ROOT}/Headers/Public/React-debug" "${PODS_ROOT}/Headers/Public/React-featureflags" "${PODS_ROOT}/Headers/Public/React-jsi" "${PODS_ROOT}/Headers/Public/React-jsinspector" "${PODS_ROOT}/Headers/Public/React-jsinspectorcdp" "${PODS_ROOT}/Headers/Public/React-jsinspectornetwork" "${PODS_ROOT}/Headers/Public/React-jsinspectortracing" "${PODS_ROOT}/Headers/Public/React-networking" "${PODS_ROOT}/Headers/Public/React-oscompat" "${PODS_ROOT}/Headers/Public/React-perflogger" "${PODS_ROOT}/Headers/Public/React-performancetimeline" "${PODS_ROOT}/Headers/Public/React-runtimeexecutor" "${PODS_ROOT}/Headers/Public/React-timing" "${PODS_ROOT}/Headers/Public/React-utils" "${PODS_ROOT}/Headers/Public/ReactNativeDependencies" "${PODS_ROOT}/Headers/Public/hermes-engine" "$(PODS_TARGET_SRCROOT)/../.." "${PODS_ROOT}/React-jsinspectornetwork" "${PODS_ROOT}/React-jsinspectortracing"
OTHER_CFLAGS = $(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml -isystem "${PODS_ROOT}/Headers/Private" -isystem "${PODS_ROOT}/Headers/Private/React-networking" -isystem "${PODS_ROOT}/Headers/Public" -isystem "${PODS_ROOT}/Headers/Public/React-Core-prebuilt" -isystem "${PODS_ROOT}/Headers/Public/React-debug" -isystem "${PODS_ROOT}/Headers/Public/React-featureflags" -isystem "${PODS_ROOT}/Headers/Public/React-jsi" -isystem "${PODS_ROOT}/Headers/Public/React-jsinspector" -isystem "${PODS_ROOT}/Headers/Public/React-jsinspectorcdp" -isystem "${PODS_ROOT}/Headers/Public/React-jsinspectornetwork" -isystem "${PODS_ROOT}/Headers/Public/React-jsinspectortracing" -isystem "${PODS_ROOT}/Headers/Public/React-networking" -isystem "${PODS_ROOT}/Headers/Public/React-oscompat" -isystem "${PODS_ROOT}/Headers/Public/React-perflogger" -isystem "${PODS_ROOT}/Headers/Public/React-performancetimeline" -isystem "${PODS_ROOT}/Headers/Public/React-runtimeexecutor" -isystem "${PODS_ROOT}/Headers/Public/React-timing" -isystem "${PODS_ROOT}/Headers/Public/React-utils" -isystem "${PODS_ROOT}/Headers/Public/ReactNativeDependencies" -isystem "${PODS_ROOT}/Headers/Public/hermes-engine" -isystem "$(PODS_TARGET_SRCROOT)/../.." -isystem "${PODS_ROOT}/React-jsinspectornetwork" -isystem "${PODS_ROOT}/React-jsinspectortracing" -isystem "${PODS_ROOT}/React-Core-prebuilt/React-Core-prebuilt.framework/Headers" -isystem "${PODS_ROOT}/ReactNativeDependencies/framework/packages/react-native/react-native.framework/Headers" -isystem "${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal/universal.framework/Headers" -isystem "${PODS_XCFRAMEWORKS_BUILD_DIR}/React-Core-prebuilt/React-Core-prebuilt.framework/Headers" -isystem "${PODS_XCFRAMEWORKS_BUILD_DIR}/ReactNativeDependencies/ReactNativeDependencies.framework/Headers" -isystem "${PODS_XCFRAMEWORKS_BUILD_DIR}/hermes-engine/Pre-built/Pre-built.framework/Headers" -isystem "${PODS_ROOT}/React-Core-prebuilt/React.xcframework/Headers" -fmodule-map-file="${PODS_ROOT}/Target\ Support\ Files/React-Core-prebuilt/React-use-frameworks.modulemap"
OTHER_CPLUSPLUSFLAGS = $(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml
OTHER_SWIFT_FLAGS = $(inherited) -Xcc -ivfsoverlay -Xcc $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Private" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Private/React-networking" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-Core-prebuilt" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-debug" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-featureflags" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-jsi" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-jsinspector" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-jsinspectorcdp" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-jsinspectornetwork" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-jsinspectortracing" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-networking" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-oscompat" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-perflogger" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-performancetimeline" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-runtimeexecutor" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-timing" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/React-utils" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/ReactNativeDependencies" -Xcc -isystem -Xcc "${PODS_ROOT}/Headers/Public/hermes-engine" -Xcc -isystem -Xcc "$(PODS_TARGET_SRCROOT)/../.." -Xcc -isystem -Xcc "${PODS_ROOT}/React-jsinspectornetwork" -Xcc -isystem -Xcc "${PODS_ROOT}/React-jsinspectortracing" -Xcc -isystem -Xcc "${PODS_ROOT}/React-Core-prebuilt/React-Core-prebuilt.framework/Headers" -Xcc -isystem -Xcc "${PODS_ROOT}/ReactNativeDependencies/framework/packages/react-native/react-native.framework/Headers" -Xcc -isystem -Xcc "${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal/universal.framework/Headers" -Xcc -isystem -Xcc "${PODS_XCFRAMEWORKS_BUILD_DIR}/React-Core-prebuilt/React-Core-prebuilt.framework/Headers" -Xcc -isystem -Xcc "${PODS_XCFRAMEWORKS_BUILD_DIR}/ReactNativeDependencies/ReactNativeDependencies.framework/Headers" -Xcc -isystem -Xcc "${PODS_XCFRAMEWORKS_BUILD_DIR}/hermes-engine/Pre-built/Pre-built.framework/Headers" -Xcc -isystem -Xcc "${PODS_ROOT}/React-Core-prebuilt/React.xcframework/Headers" -Xcc -fmodule-map-file="${PODS_ROOT}/Target\ Support\ Files/React-Core-prebuilt/React-use-frameworks.modulemap"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/../../node_modules/react-native/ReactCommon/react/networking
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
SWIFT_EMIT_MODULE_INTERFACE = NO
