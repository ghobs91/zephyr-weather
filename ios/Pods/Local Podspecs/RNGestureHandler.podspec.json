{
  "name": "RNGestureHandler",
  "version": "2.32.0",
  "summary": "Declarative API exposing native platform touch and gesture system to React Native",
  "homepage": "https://github.com/software-mansion/react-native-gesture-handler",
  "license": "MIT",
  "authors": {
    "Krzysztof Magiera": "krzys.magiera@gmail.com"
  },
  "source": {
    "git": "https://github.com/software-mansion/react-native-gesture-handler",
    "tag": "2.32.0"
  },
  "source_files": "apple/**/*.{h,m,mm}",
  "requires_arc": true,
  "platforms": {
    "ios": "11.0",
    "tvos": "11.0",
    "osx": "10.15",
    "visionos": "1.0"
  },
  "xcconfig": {
    "OTHER_CFLAGS": "$(inherited)  -DREACT_NATIVE_MINOR_VERSION=86"
  },
  "compiler_flags": "-DRCT_NEW_ARCH_ENABLED=1",
  "dependencies": {
    "React-Core": [],
    "React-RCTFabric": [],
    "ReactCodegen": [],
    "RCTRequired": [],
    "RCTTypeSafety": [],
    "ReactCommon/turbomodule/bridging": [],
    "ReactCommon/turbomodule/core": [],
    "React-NativeModulesApple": [],
    "Yoga": [],
    "React-Fabric": [],
    "React-graphics": [],
    "React-utils": [],
    "React-featureflags": [],
    "React-debug": [],
    "React-ImageManager": [],
    "React-rendererdebug": [],
    "React-jsi": [],
    "React-renderercss": [],
    "hermes-engine": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": [],
    "React-FabricComponents": []
  },
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "\"$(PODS_ROOT)/Headers/Private/Yoga\" \"${PODS_ROOT}/React-graphics\" \"${PODS_ROOT}/React-graphics/react/renderer/graphics/platform/ios\" \"${PODS_ROOT}/React-Fabric\" \"${PODS_ROOT}/React-Fabric/react/renderer/components/view/platform/cxx\" \"${PODS_ROOT}/React-FabricImage\" \"${PODS_ROOT}/ReactCommon\" \"${PODS_ROOT}/ReactCommon/react/nativemodule/core\" \"${PODS_ROOT}/React-runtimeexecutor\" \"${PODS_ROOT}/React-runtimeexecutor/platform/ios\" \"${PODS_ROOT}/React-NativeModulesApple\" \"${PODS_ROOT}/React-RCTFabric\" \"${PODS_ROOT}/React-utils\" \"${PODS_ROOT}/React-featureflags\" \"${PODS_ROOT}/React-debug\" \"${PODS_ROOT}/React-ImageManager\" \"${PODS_ROOT}/React-rendererdebug\" \"${PODS_ROOT}/React-renderercss\" \"${PODS_ROOT}/React-FabricComponents\" \"${PODS_ROOT}/React-FabricComponents/react/renderer/textlayoutmanager/platform/ios\" \"${PODS_ROOT}/React-FabricComponents/react/renderer/components/textinput/platform/ios\" \"${PODS_ROOT}/React-FabricComponents/react/renderer/components/text/platform/cxx\"",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED=1  -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "OTHER_SWIFT_FLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED -Xcc -ivfsoverlay -Xcc $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "OTHER_CFLAGS": "$(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml"
  }
}
