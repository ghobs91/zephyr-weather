{
  "name": "ExpoModulesCore",
  "version": "57.0.9",
  "summary": "The core of Expo Modules architecture",
  "description": "The core of Expo Modules architecture",
  "license": "MIT",
  "authors": "650 Industries, Inc.",
  "homepage": "https://github.com/expo/expo/tree/main/packages/expo-modules-core",
  "platforms": {
    "ios": "16.4",
    "osx": "13.4",
    "tvos": "16.4"
  },
  "swift_versions": "6.0",
  "source": {
    "git": "https://github.com/expo/expo.git"
  },
  "pod_target_xcconfig": {
    "USE_HEADERMAP": "YES",
    "DEFINES_MODULE": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "SWIFT_COMPILATION_MODE": "wholemodule",
    "OTHER_SWIFT_FLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED -Xcc -ivfsoverlay -Xcc $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "HEADER_SEARCH_PATHS": "\"${PODS_CONFIGURATION_BUILD_DIR}/React-jsinspectortracing/jsinspector_moderntracing.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-jsinspectorcdp/jsinspector_moderncdp.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-runtimescheduler/React_runtimescheduler.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-performancetimeline/React_performancetimeline.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-rendererconsistency/React_rendererconsistency.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-timing/React_timing.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-debug/React_debug.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/RCT-Folly/folly.framework/Headers\" \"$(PODS_ROOT)/DoubleConversion\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-RuntimeApple/React_RuntimeApple.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-RuntimeCore/React_RuntimeCore.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-jsitooling/JSITooling.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-jserrorhandler/React_jserrorhandler.framework/Headers\" \"${PODS_ROOT}/React-jsinspector\" \"$(PODS_ROOT)/Headers/Private/Yoga\" \"${PODS_ROOT}/React-graphics\" \"${PODS_ROOT}/React-graphics/react/renderer/graphics/platform/ios\" \"${PODS_ROOT}/React-Fabric\" \"${PODS_ROOT}/React-Fabric/react/renderer/components/view/platform/cxx\" \"${PODS_ROOT}/React-FabricImage\" \"${PODS_ROOT}/ReactCommon\" \"${PODS_ROOT}/ReactCommon/react/nativemodule/core\" \"${PODS_ROOT}/React-runtimeexecutor\" \"${PODS_ROOT}/React-runtimeexecutor/platform/ios\" \"${PODS_ROOT}/React-NativeModulesApple\" \"${PODS_ROOT}/React-RCTFabric\" \"${PODS_ROOT}/React-utils\" \"${PODS_ROOT}/React-featureflags\" \"${PODS_ROOT}/React-debug\" \"${PODS_ROOT}/React-ImageManager\" \"${PODS_ROOT}/React-rendererdebug\" \"${PODS_ROOT}/React-renderercss\"",
    "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) EXPO_MODULES_CORE_VERSION=57.0.9",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED=1  -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "OTHER_CFLAGS": "$(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml"
  },
  "user_target_xcconfig": {
    "HEADER_SEARCH_PATHS": [
      "\"${PODS_CONFIGURATION_BUILD_DIR}/ExpoModulesCore/Swift Compatibility Header\"",
      "\"$(PODS_ROOT)/Headers/Private/Yoga\""
    ],
    "OTHER_LDFLAGS": "$(inherited) -lc++"
  },
  "dependencies": {
    "hermes-engine": [],
    "React-jsinspector": [],
    "React-Core": [],
    "ReactCommon/turbomodule/core": [],
    "React-NativeModulesApple": [],
    "React-RCTFabric": [],
    "ExpoModulesJSI": [],
    "ReactCodegen": [],
    "RCTRequired": [],
    "RCTTypeSafety": [],
    "ReactCommon/turbomodule/bridging": [],
    "Yoga": [],
    "React-Fabric": [],
    "React-graphics": [],
    "React-utils": [],
    "React-featureflags": [],
    "React-debug": [],
    "React-ImageManager": [],
    "React-rendererdebug": [],
    "React-jsi": [],
    "React-renderercss": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": []
  },
  "compiler_flags": "-DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 -DFOLLY_HAVE_CLOCK_GETTIME=1 -Wno-comma -Wno-shorten-64-to-32 -DREACT_NATIVE_TARGET_VERSION=86 -DUSE_HERMES -DRCT_NEW_ARCH_ENABLED",
  "static_framework": true,
  "header_dir": "ExpoModulesCore",
  "source_files": [
    "ios/**/*.{h,m,mm,swift,cpp}",
    "common/cpp/**/*.{h,cpp}"
  ],
  "exclude_files": [
    "ios/Tests",
    "ios/Worklets",
    "ios/WorkletsTests",
    "ios/WorkletsAdapter"
  ],
  "private_header_files": [
    "ios/**/*+Private.h",
    "ios/**/Swift.h"
  ],
  "testspecs": [
    {
      "name": "Tests",
      "test_type": "unit",
      "dependencies": {
        "ExpoModulesTestCore": []
      },
      "source_files": "ios/Tests/**/*.{h,m,mm,swift}",
      "pod_target_xcconfig": {
        "OTHER_LDFLAGS": "$(inherited) -lc++",
        "SWIFT_OBJC_BRIDGING_HEADER": "$(PODS_TARGET_SRCROOT)/ios/Tests/Tests-Bridging-Header.h"
      }
    }
  ],
  "swift_version": "6.0"
}
