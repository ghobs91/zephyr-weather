{
  "name": "React-FabricImage",
  "version": "0.86.2",
  "summary": "Image Component for Fabric for React Native.",
  "homepage": "https://reactnative.dev/",
  "license": "MIT",
  "authors": "Meta Platforms, Inc. and its affiliates",
  "platforms": {
    "ios": "15.1"
  },
  "source": {
    "git": "https://github.com/react/react-native.git",
    "tag": "v0.86.2"
  },
  "source_files": "react/renderer/components/image/**/*.h",
  "exclude_files": "react/renderer/components/image/tests",
  "header_dir": "react/renderer/components/image",
  "pod_target_xcconfig": {
    "USE_HEADERMAP": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "HEADER_SEARCH_PATHS": "\"$(PODS_TARGET_SRCROOT)/ReactCommon\" \"$(PODS_ROOT)/Headers/Private/Yoga\" \"$(PODS_TARGET_SRCROOT)\" \"$(PODS_TARGET_SRCROOT)/react/renderer/textlayoutmanager/platform/ios\" \"$(PODS_TARGET_SRCROOT)/react/renderer/components/text/platform/cxx\" \"$(PODS_TARGET_SRCROOT)/react/renderer/components/textinput/platform/ios\" \"${PODS_ROOT}/React-ImageManager\" \"${PODS_ROOT}/React-ImageManager/react/renderer/components/view/platform/cxx\" \"${PODS_ROOT}/React-ImageManager/react/renderer/imagemanager/platform/ios\" \"${PODS_ROOT}/ReactCommon\" \"${PODS_ROOT}/React-graphics\" \"${PODS_ROOT}/React-graphics/react/renderer/graphics/platform/ios\" \"${PODS_ROOT}/React-Fabric\" \"${PODS_ROOT}/React-Fabric/react/renderer/components/view/platform/cxx\" \"${PODS_ROOT}/React-Fabric/react/renderer/imagemanager/platform/ios\" \"${PODS_ROOT}/React-rendererdebug\"",
    "OTHER_CFLAGS": "$(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "OTHER_SWIFT_FLAGS": "$(inherited) -Xcc -ivfsoverlay -Xcc $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml"
  },
  "module_name": "React_FabricImage",
  "dependencies": {
    "React-jsiexecutor": [
      "0.86.2"
    ],
    "RCTRequired": [
      "0.86.2"
    ],
    "RCTTypeSafety": [
      "0.86.2"
    ],
    "React-jsi": [],
    "React-logger": [],
    "React-featureflags": [],
    "React-utils": [],
    "Yoga": [],
    "React-ImageManager": [],
    "ReactCommon": [],
    "React-graphics": [],
    "React-Fabric": [],
    "React-rendererdebug": [],
    "hermes-engine": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": []
  }
}
