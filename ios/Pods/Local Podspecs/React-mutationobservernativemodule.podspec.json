{
  "name": "React-mutationobservernativemodule",
  "version": "0.86.2",
  "summary": "React Native mutation observer native module",
  "homepage": "https://reactnative.dev/",
  "license": "MIT",
  "authors": "Meta Platforms, Inc. and its affiliates",
  "platforms": {
    "ios": "15.1"
  },
  "source": {
    "git": "https://github.com/react/react-native.git",
    "tag": "v0.86.2"
  },
  "source_files": "*.h",
  "header_dir": "react/nativemodule/mutationobserver",
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "HEADER_SEARCH_PATHS": "\"$(PODS_ROOT)/Headers/Private/Yoga\" \"$(PODS_TARGET_SRCROOT)/../../..\" \"${PODS_ROOT}/React-RCTFBReactNativeSpec\" \"${PODS_ROOT}/React-runtimeexecutor\" \"${PODS_ROOT}/React-runtimeexecutor/platform/ios\"",
    "OTHER_CFLAGS": "$(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "DEFINES_MODULE": "YES",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "OTHER_SWIFT_FLAGS": "$(inherited) -Xcc -ivfsoverlay -Xcc $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml"
  },
  "module_name": "mutationobservernativemodule",
  "header_mappings_dir": "../..",
  "dependencies": {
    "Yoga": [],
    "React-jsi": [],
    "React-jsiexecutor": [],
    "React-cxxreact": [],
    "hermes-engine": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": [],
    "ReactCommon/turbomodule/core": [],
    "React-Fabric": [],
    "React-Fabric/bridging": [],
    "React-Fabric/observers/mutation": [],
    "React-featureflags": [],
    "React-RCTFBReactNativeSpec": [],
    "React-runtimeexecutor": []
  }
}
