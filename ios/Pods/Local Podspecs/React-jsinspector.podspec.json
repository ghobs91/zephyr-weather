{
  "name": "React-jsinspector",
  "version": "0.86.2",
  "summary": "React Native subsystem for modern debugging over the Chrome DevTools Protocol (CDP)",
  "homepage": "https://reactnative.dev/",
  "license": "MIT",
  "authors": "Meta Platforms, Inc. and its affiliates",
  "platforms": {
    "ios": "15.1"
  },
  "source": {
    "git": "https://github.com/react/react-native.git",
    "tag": "v0.86.2"
  },
  "source_files": "*.h",
  "header_dir": "jsinspector-modern",
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "\"$(PODS_TARGET_SRCROOT)/..\" \"${PODS_ROOT}/React-oscompat\" \"${PODS_ROOT}/React-runtimeexecutor\" \"${PODS_ROOT}/React-runtimeexecutor/platform/ios\" \"${PODS_ROOT}/React-jsinspectorcdp\" \"${PODS_ROOT}/React-jsinspectornetwork\" \"${PODS_ROOT}/React-jsinspectortracing\" \"${PODS_ROOT}/React-oscompat\" \"${PODS_ROOT}/React-utils\" \"${PODS_ROOT}/React-utils/react/utils/platform/ios\"",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "DEFINES_MODULE": "YES",
    "PUBLIC_HEADERS_FOLDER_PATH": "jsinspector_modern.framework/Headers/jsinspector-modern",
    "OTHER_CFLAGS": "$(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -ivfsoverlay $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml",
    "OTHER_SWIFT_FLAGS": "$(inherited) -Xcc -ivfsoverlay -Xcc $(PODS_ROOT)/React-Core-prebuilt/React-VFS.yaml"
  },
  "module_name": "jsinspector_modern",
  "dependencies": {
    "React-oscompat": [],
    "React-featureflags": [],
    "React-runtimeexecutor": [],
    "React-jsi": [],
    "React-jsinspectorcdp": [],
    "React-jsinspectornetwork": [],
    "React-jsinspectortracing": [],
    "React-perflogger": [
      "0.86.2"
    ],
    "React-utils": [],
    "hermes-engine": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": []
  }
}
